# Локальная правка движка RobustToolbox (submodule), НЕ входит в upstream space-wizards.
# Файл: RobustToolbox/Robust.Shared/Reflection/ReflectionManager.cs
# Причина: _sawmill может быть null в момент обхода enum-ссылок, из-за чего валится NRE.
# Актуально для движка 293.0.1 (de49cf724).
# Применение:
#   git -C RobustToolbox apply ..\Tools\patches\robust-reflectionmanager-null-guard.patch
#
diff --git a/Robust.Shared/Reflection/ReflectionManager.cs b/Robust.Shared/Reflection/ReflectionManager.cs
index 0d7fedf56..60c4dc914 100644
--- a/Robust.Shared/Reflection/ReflectionManager.cs
+++ b/Robust.Shared/Reflection/ReflectionManager.cs
@@ -398,8 +398,12 @@ namespace Robust.Shared.Reflection
                         if (!_reverseEnumCache.TryAdd(e, r) &&
                             r != _reverseEnumCache[e])
                         {
-                            _sawmill.Warning(
-                                $"Conflicting enum references encountered. Enum: {e}. Existing: {_reverseEnumCache[e]}. New: {r}");
+                            // UU patch: _sawmill может быть null, если резолв идёт до Initialize.
+                            if (_sawmill != null)
+                            {
+                                _sawmill.Warning(
+                                    $"Conflicting enum references encountered. Enum: {e}. Existing: {_reverseEnumCache[e]}. New: {r}");
+                            }
                         }
 
                         return e;
