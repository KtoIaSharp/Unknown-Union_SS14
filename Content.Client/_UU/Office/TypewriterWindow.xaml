<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'typewriter-window-title'}"
               MinSize="440 400">
    <!-- Тёмная основа в стиле UU -->
    <PanelContainer StyleClasses="PdaBackgroundRect" ModulateSelfOverride="#121212" />
    <PanelContainer StyleClasses="PdaBorderRect" Modulate="#31383f" />

    <BoxContainer Orientation="Vertical">

        <BoxContainer Orientation="Horizontal" Margin="10 8 10 4" HorizontalExpand="True">
            <EntityPrototypeView Name="DeviceView" Scale="1.5 1.5" MinSize="48 48"
                                 Margin="0 0 8 0" VerticalAlignment="Center" />
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center">
                <Label Text="{Loc 'typewriter-window-title'}" StyleClasses="ConsoleHeading" />
                <Label Name="StatusLabel" Text="{Loc 'typewriter-no-paper'}" StyleClasses="LabelSubText" />
            </BoxContainer>
        </BoxContainer>

        <PanelContainer StyleClasses="LowDivider" HorizontalExpand="True" Margin="10 0 10 8" SetHeight="2" />

        <Label Text="{Loc 'typewriter-forms-title'}" StyleClasses="ConsoleSubHeading" Margin="10 0 10 4" />

        <ScrollContainer VerticalExpand="True" MinSize="0 200" Margin="10 0 10 0">
            <BoxContainer Name="FormsContainer" Orientation="Vertical" SeparationOverride="4" HorizontalExpand="True" />
        </ScrollContainer>

        <Control MinSize="0 10" />
        <Label Text="{Loc 'typewriter-footer'}"
               StyleClasses="LabelSubText"
               HorizontalAlignment="Center"
               Margin="10 0 10 8" />
    </BoxContainer>
</DefaultWindow>
