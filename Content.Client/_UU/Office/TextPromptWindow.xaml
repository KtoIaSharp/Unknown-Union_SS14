<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'text-prompt-default-title'}"
               MinSize="420 240">
    <!-- РўС‘РјРЅР°СЏ РѕСЃРЅРѕРІР° РІ СЃС‚РёР»Рµ UU -->
    <PanelContainer StyleClasses="PdaBackgroundRect" ModulateSelfOverride="#121212" />
    <PanelContainer StyleClasses="PdaBorderRect" Modulate="#31383f" />

    <BoxContainer Orientation="Vertical">

        <BoxContainer Orientation="Horizontal" Margin="10 8 10 4" HorizontalExpand="True">
            <EntityPrototypeView Name="DeviceView" Scale="1.5 1.5" MinSize="48 48"
                                 Margin="0 0 8 0" VerticalAlignment="Center" />
            <Label Name="HeaderLabel" StyleClasses="ConsoleHeading"
                   HorizontalExpand="True" VerticalAlignment="Center" />
        </BoxContainer>

        <PanelContainer StyleClasses="LowDivider" HorizontalExpand="True" Margin="10 0 10 8" SetHeight="2" />

        <BoxContainer Orientation="Vertical" Margin="10 0 10 0" HorizontalExpand="True">
            <RichTextLabel Name="PromptLabel" StyleClasses="LabelSubText" MaxWidth="380" />
            <Control MinSize="0 8" />
            <LineEdit Name="Input" HorizontalExpand="True" />
            <Control MinSize="0 12" />
            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="8">
                <Button Name="SubmitButton" StyleClasses="ButtonColorRed" MinWidth="150" />
                <Button Name="CancelButton" StyleClasses="ButtonColorRed" MinWidth="150" />
            </BoxContainer>
        </BoxContainer>

        <Control MinSize="0 10" />
        <Label Text="{Loc 'text-prompt-footer'}"
               StyleClasses="LabelSubText"
               HorizontalAlignment="Center"
               Margin="10 0 10 8" />
    </BoxContainer>
</DefaultWindow>
