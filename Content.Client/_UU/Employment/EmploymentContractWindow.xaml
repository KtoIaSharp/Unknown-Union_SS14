<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'employment-contract-window-title'}"
               MinSize="460 420">
    <!-- Тёмная основа в стиле UU -->
    <PanelContainer StyleClasses="PdaBackgroundRect" ModulateSelfOverride="#121212" />
    <PanelContainer StyleClasses="PdaBorderRect" Modulate="#31383f" />

    <BoxContainer Orientation="Vertical">

        <BoxContainer Orientation="Horizontal" Margin="10 8 10 4" HorizontalExpand="True">
            <EntityPrototypeView Name="DeviceView" Scale="1.5 1.5" MinSize="48 48"
                                 Margin="0 0 8 0" VerticalAlignment="Center" />
            <BoxContainer Orientation="Vertical" VerticalAlignment="Center" HorizontalExpand="True">
                <Label Text="{Loc 'employment-contract-window-title'}" StyleClasses="ConsoleHeading" />
                <Label Name="StatusLabel" StyleClasses="LabelSubText"
                       Text="{Loc 'employment-contract-status-draft'}" />
            </BoxContainer>
        </BoxContainer>

        <PanelContainer StyleClasses="LowDivider" HorizontalExpand="True" Margin="10 0 10 8" SetHeight="2" />

        <BoxContainer Orientation="Vertical" Margin="10 0 10 0" HorizontalExpand="True">
            <Label Text="{Loc 'employment-contract-worker'}" StyleClasses="ConsoleSubHeading" />
            <LineEdit Name="WorkerInput" PlaceHolder="{Loc 'employment-contract-worker-placeholder'}"
                      HorizontalExpand="True" />

            <Control MinSize="0 6" />
            <Label Text="{Loc 'employment-contract-position'}" StyleClasses="ConsoleSubHeading" />
            <LineEdit Name="PositionInput" PlaceHolder="{Loc 'employment-contract-position-placeholder'}"
                      HorizontalExpand="True" />

            <Control MinSize="0 6" />
            <Label Text="{Loc 'employment-contract-employer'}" StyleClasses="ConsoleSubHeading" />
            <LineEdit Name="EmployerInput" PlaceHolder="{Loc 'employment-contract-employer-placeholder'}"
                      HorizontalExpand="True" />

            <Control MinSize="0 8" />
            <Button Name="ApplyButton" Text="{Loc 'employment-contract-apply'}"
                    StyleClasses="ButtonColorRed"
                    HorizontalAlignment="Center" MinWidth="200" />
        </BoxContainer>

        <Control MinSize="0 10" />

        <BoxContainer Orientation="Vertical" Margin="10 0 10 0" HorizontalExpand="True">
            <Label Name="DateLabel" StyleClasses="ConsoleText" HorizontalAlignment="Center"
                   Text="{Loc 'employment-contract-date-empty'}" />
            <Control MinSize="0 6" />
            <Label Name="EmployerSignLabel" StyleClasses="LabelSubText"
                   Text="{Loc 'employment-contract-sign-missing'}" />
            <Label Name="WorkerSignLabel" StyleClasses="LabelSubText"
                   Text="{Loc 'employment-contract-sign-missing'}" />

            <Control MinSize="0 8" />
            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Name="SignEmployerButton" Text="{Loc 'employment-contract-sign-employer'}"
                        StyleClasses="ButtonColorRed" Margin="0 0 6 0" />
                <Button Name="SignWorkerButton" Text="{Loc 'employment-contract-sign-worker'}"
                        StyleClasses="ButtonColorRed" />
            </BoxContainer>

            <Control MinSize="0 6" />
            <Button Name="SignStateButton" Text="{Loc 'employment-contract-sign-state'}"
                    StyleClasses="ButtonColorRed"
                    HorizontalAlignment="Center" MinWidth="260" Visible="False" />
        </BoxContainer>

        <Control MinSize="0 10" />
        <BoxContainer Orientation="Vertical" Margin="10 0 10 8" HorizontalAlignment="Center">
            <Label Text="{Loc 'employment-contract-footer'}"
                   StyleClasses="LabelSubText"
                   HorizontalAlignment="Center" />
            <Label Text="{Loc 'employment-contract-footer-2'}"
                   StyleClasses="LabelSubText"
                   HorizontalAlignment="Center" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
