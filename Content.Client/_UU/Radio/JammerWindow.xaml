<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'radio-jammer-title'}"
               MinSize="380 190">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True">

        <!-- Шапка терминала: иконка устройства + моноширинный заголовок -->
        <BoxContainer Orientation="Horizontal" Margin="10 8 10 4" HorizontalExpand="True">
            <TextureRect TexturePath="/Textures/Objects/Devices/jammer.rsi/jammer.png"
                         SetSize="28 28" Margin="0 0 8 0" VerticalAlignment="Center" />
            <Label Text="{Loc 'radio-jammer-title'}"
                   StyleClasses="ConsoleHeading"
                   HorizontalExpand="True"
                   VerticalAlignment="Center" />
        </BoxContainer>

        <PanelContainer StyleClasses="LowDivider" HorizontalExpand="True" Margin="10 0 10 8" SetHeight="2" />

        <BoxContainer Orientation="Vertical" Margin="10 0 10 0" HorizontalExpand="True">
            <Label Name="CurrentLabel" StyleClasses="ConsoleText" HorizontalAlignment="Center" />
            <Control MinSize="0 10" />
            <Label Text="{Loc 'radio-enter-frequency'}" StyleClasses="ConsoleSubHeading" />
            <LineEdit Name="FreqInput" PlaceHolder="{Loc 'radio-frequency-placeholder'}" HorizontalExpand="True" />
            <Control MinSize="0 12" />
            <Button Name="SetButton" Text="{Loc 'radio-set-frequency'}"
                    StyleClasses="ButtonColorRed"
                    HorizontalAlignment="Center" MinWidth="180" />
        </BoxContainer>

        <Control MinSize="0 10" />
        <Label Text="{Loc 'radio-jammer-footer'}"
               StyleClasses="LabelSubText"
               HorizontalAlignment="Center"
               Margin="10 0 10 8" />
    </BoxContainer>
</DefaultWindow>
