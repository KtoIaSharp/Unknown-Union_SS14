<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'work-console-access-title'}"
               MinSize="520 340">
    <PanelContainer StyleClasses="PdaBackgroundRect" ModulateSelfOverride="#121212" />
    <PanelContainer StyleClasses="PdaBorderRect" Modulate="#31383f" />

    <BoxContainer Orientation="Vertical">
        <Label Text="{Loc 'work-console-access-title'}" StyleClasses="ConsoleHeading" Margin="10 8 10 4" />
        <PanelContainer StyleClasses="LowDivider" HorizontalExpand="True" Margin="10 0 10 8" SetHeight="2" />

        <BoxContainer Orientation="Horizontal" Margin="10 0 10 0" SeparationOverride="16" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4">
                <Label Text="{Loc 'work-console-access-use'} " StyleClasses="ConsoleSubHeading" />
                <ScrollContainer MinSize="0 180" VerticalExpand="True">
                    <BoxContainer Name="UseColumn" Orientation="Vertical" SeparationOverride="2" HorizontalExpand="True" />
                </ScrollContainer>
            </BoxContainer>
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4">
                <Label Text="{Loc 'work-console-access-edit'}" StyleClasses="ConsoleSubHeading" />
                <ScrollContainer MinSize="0 180" VerticalExpand="True">
                    <BoxContainer Name="EditColumn" Orientation="Vertical" SeparationOverride="2" HorizontalExpand="True" />
                </ScrollContainer>
            </BoxContainer>
        </BoxContainer>

        <Control MinSize="0 8" />

        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="8">
            <Button Name="SaveButton" Text="{Loc 'work-console-access-save'}" StyleClasses="ButtonColorRed" MinWidth="150" />
            <Button Name="CancelButton" Text="{Loc 'text-prompt-cancel'}" StyleClasses="ButtonColorRed" MinWidth="150" />
        </BoxContainer>

        <Control MinSize="0 10" />
        <Label Text="{Loc 'work-console-access-footer'}" StyleClasses="LabelSubText"
               HorizontalAlignment="Center" Margin="10 0 10 8" />
    </BoxContainer>
</DefaultWindow>
