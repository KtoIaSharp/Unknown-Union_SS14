<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'work-card-window-title'}"
               MinSize="520 300">
    <PanelContainer StyleClasses="PdaBackgroundRect" ModulateSelfOverride="#121212" />
    <PanelContainer StyleClasses="PdaBorderRect" Modulate="#31383f" />

    <BoxContainer Orientation="Vertical">
        <BoxContainer Orientation="Horizontal" Margin="10 8 10 4" HorizontalExpand="True">
            <EntityPrototypeView Name="DeviceView" Scale="1.25 1.25" MinSize="40 40"
                                 Margin="0 0 8 0" VerticalAlignment="Center" />
            <Label Text="{Loc 'work-card-window-title'}" StyleClasses="ConsoleHeading"
                   HorizontalExpand="True" VerticalAlignment="Center" />
            <Label Name="RevokedLabel" Text="{Loc 'work-card-revoked'}"
                   StyleClasses="LabelSubText" VerticalAlignment="Center" Visible="False" />
        </BoxContainer>

        <PanelContainer StyleClasses="LowDivider" HorizontalExpand="True" Margin="10 0 10 6" SetHeight="2" />

        <BoxContainer Orientation="Horizontal" Margin="10 0 10 0" SeparationOverride="12">
            <PanelContainer StyleClasses="PdaBorderRect" MinSize="88 88" VerticalAlignment="Top">
                <BoxContainer Orientation="Vertical" VerticalAlignment="Center">
                    <TextureRect Name="PhotoTexture" MinSize="84 84" Stretch="KeepAspectCentered" />
                    <Label Name="NoPhotoLabel" Text="{Loc 'work-card-no-photo'}"
                           StyleClasses="LabelSubText" HorizontalAlignment="Center" MaxWidth="82" />
                </BoxContainer>
            </PanelContainer>

            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="1">
                <Label Name="HolderLabel" StyleClasses="ConsoleHeading" />
                <Label Name="PositionLabel" StyleClasses="ConsoleSubHeading" />
                <Label Text="{Loc 'work-card-employer'}" StyleClasses="LabelSubText" Margin="0 6 0 0" />
                <Label Name="EmployerLabel" StyleClasses="ConsoleText" />
            </BoxContainer>
        </BoxContainer>

        <PanelContainer StyleClasses="LowDivider" HorizontalExpand="True" Margin="10 8 10 6" SetHeight="2" />

        <BoxContainer Orientation="Horizontal" Margin="10 0 10 0" SeparationOverride="16">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="1">
                <Label Text="{Loc 'work-card-workplace'}" StyleClasses="LabelSubText" />
                <Label Name="WorkplaceLabel" StyleClasses="ConsoleText" />
                <Label Text="{Loc 'work-card-date'}" StyleClasses="LabelSubText" Margin="0 4 0 0" />
                <Label Name="DateLabel" StyleClasses="ConsoleText" />
            </BoxContainer>

            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="1">
                <Label Text="{Loc 'work-card-tag'}" StyleClasses="LabelSubText" />
                <Label Name="TagLabel" StyleClasses="ConsoleText" />
                <Label Text="{Loc 'work-card-signatures'}" StyleClasses="LabelSubText" Margin="0 4 0 0" />
                <Label Name="EmployerSignatureLabel" StyleClasses="ConsoleText" />
                <Label Name="WorkerSignatureLabel" StyleClasses="ConsoleText" />
                <Label Text="{Loc 'work-card-stamp'}" StyleClasses="LabelSubText" Margin="0 4 0 0" />
                <Label Name="StampLabel" StyleClasses="ConsoleText" />
            </BoxContainer>
        </BoxContainer>

        <RichTextLabel Text="{Loc 'work-card-footer'}" StyleClasses="LabelSubText"
                       HorizontalAlignment="Center" Margin="10 8 10 8" MaxWidth="480" />
    </BoxContainer>
</DefaultWindow>
