<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'work-card-window-title'}"
               MinSize="420 420">
    <PanelContainer StyleClasses="PdaBackgroundRect" ModulateSelfOverride="#121212" />
    <PanelContainer StyleClasses="PdaBorderRect" Modulate="#31383f" />

    <BoxContainer Orientation="Vertical">
        <BoxContainer Orientation="Horizontal" Margin="10 8 10 4" HorizontalExpand="True">
            <EntityPrototypeView Name="DeviceView" Scale="1.5 1.5" MinSize="48 48"
                                 Margin="0 0 8 0" VerticalAlignment="Center" />
            <Label Text="{Loc 'work-card-window-title'}" StyleClasses="ConsoleHeading"
                   HorizontalExpand="True" VerticalAlignment="Center" />
        </BoxContainer>

        <PanelContainer StyleClasses="LowDivider" HorizontalExpand="True" Margin="10 0 10 8" SetHeight="2" />

        <BoxContainer Orientation="Horizontal" Margin="10 0 10 0" SeparationOverride="10">
            <PanelContainer StyleClasses="PdaBorderRect" MinSize="96 96" VerticalAlignment="Top">
                <BoxContainer Orientation="Vertical" VerticalAlignment="Center">
                    <TextureRect Name="PhotoTexture" MinSize="92 92" Stretch="KeepAspectCentered" />
                    <Label Name="NoPhotoLabel" Text="{Loc 'work-card-no-photo'}"
                           StyleClasses="LabelSubText" HorizontalAlignment="Center" MaxWidth="90" />
                </BoxContainer>
            </PanelContainer>

            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="2">
                <Label Text="{Loc 'work-card-holder'}" StyleClasses="ConsoleSubHeading" />
                <Label Name="HolderLabel" StyleClasses="ConsoleText" />
                <Label Text="{Loc 'work-card-position'}" StyleClasses="ConsoleSubHeading" />
                <Label Name="PositionLabel" StyleClasses="ConsoleText" />
                <Label Text="{Loc 'work-card-employer'}" StyleClasses="ConsoleSubHeading" />
                <Label Name="EmployerLabel" StyleClasses="ConsoleText" />
            </BoxContainer>
        </BoxContainer>

        <Control MinSize="0 8" />

        <BoxContainer Orientation="Vertical" Margin="10 0 10 0" SeparationOverride="2">
            <Label Text="{Loc 'work-card-workplace'}" StyleClasses="ConsoleSubHeading" />
            <Label Name="WorkplaceLabel" StyleClasses="ConsoleText" />
            <Label Text="{Loc 'work-card-tag'}" StyleClasses="ConsoleSubHeading" />
            <Label Name="TagLabel" StyleClasses="ConsoleText" />
            <Label Text="{Loc 'work-card-date'}" StyleClasses="ConsoleSubHeading" />
            <Label Name="DateLabel" StyleClasses="ConsoleText" />
            <Label Text="{Loc 'work-card-signature'}" StyleClasses="ConsoleSubHeading" />
            <Label Name="SignatureLabel" StyleClasses="ConsoleText" />
        </BoxContainer>

        <Control MinSize="0 10" />
        <Label Text="{Loc 'work-card-footer'}" StyleClasses="LabelSubText"
               HorizontalAlignment="Center" Margin="10 0 10 8" />
    </BoxContainer>
</DefaultWindow>
